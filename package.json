{
  "name": "jev-proxy",
  "version": "0.1.0",
  "description": "A policy firewall for MCP tool calls.",
  "type": "module",
  "bin": {
    "jev-proxy": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test tests/*.test.ts",
    "release:check": "npm run check && npm test && npm run build && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/jev-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/gbesse/jev-proxy/issues"
  },
  "homepage": "https://github.com/gbesse/jev-proxy#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "agent-security",
    "security",
    "policy",
    "proxy",
    "human-in-the-loop"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
